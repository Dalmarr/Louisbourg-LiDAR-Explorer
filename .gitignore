*.las
*.laz
*.zlas

# Large raster datasets
*.tif
*.tiff
*.img

# ArcGIS locks
*.lock
*.sr.lock

# Temporary / backup files
*.tmp
*.bak

# ArcGIS package/cache files
*.ppkx
*.mpkx
*.lpkx
*.slpk
*.skp


